//@version=6
// SignalFusion + ScalpStation + Soportes/Resistencias Dinámico
// Unificado: versión 2.1 (v2.1) con correcciones y optimizaciones
// Cambios:
// - Corregido max/min por math.max/math.min.
// - Reemplazado ta.adx por ta.dmi para calcular ADX (corrige error en línea 158).
// - Añadido filtro ADX para señales en tendencia.
// - Ajustados pesos de scoring para mejorar winrate.
// - Aumentado atr_mult_tp_long para mejor RR.
// - Optimizaciones menores para robustez.

strategy('SignalFusion ScalpStation SR 1.0', overlay = true, max_lines_count = 500, max_labels_count = 500, initial_capital = 100, default_qty_type = strategy.percent_of_equity, default_qty_value = 50, commission_type = strategy.commission.percent, commission_value = 0.1)

// ========================= INPUTS: GLOBAL =========================
mode = input.string('Standard', 'Modo (riesgo)', options = ['Conservative', 'Standard', 'Aggressive'])
use_ema = input.bool(false, 'Usar EMA en lugar de SMA (global)')
show_signals = input.bool(true, 'Mostrar señales (triángulos)')
show_sl_tp_markers = input.bool(true, 'Mostrar etiquetas SL/TP en entrada')
show_sl_tp_lines = input.bool(true, 'Dibujar líneas SL/TP extendidas')
auto_clear_bars = input.int(500, 'Auto-borrar SL/TP después de (barras, 0 desactivar)', minval = 0)
line_extend_bars = input.int(300, 'Longitud visual línea (barras)', minval = 10, maxval = 2000)
sr_max_age_bars = input.int(1000, 'Edad máxima de niveles S/R (barras, para borrar antiguos)', minval = 100)

// ========================= INPUTS: INDICADORES =========================
// RSI
rsi_base_len = input.int(14, 'RSI base length', minval = 2)
rsi_ma_length = input.int(7, 'RSI MA length', minval = 3)
// Bollinger
bb_length = input.int(20, 'BB length')
bb_stddev = input.float(2.0, 'BB stddev', step = 0.1)
// Tendencia
trend_length = input.int(50, 'Trend MA length')
// MACD
macd_fast = input.int(12, 'MACD fast')
macd_slow = input.int(26, 'MACD slow')
macd_signal_len = input.int(9, 'MACD signal length')
// EMAs (scalp stations)
ema_fast_len = input.int(9, 'EMA Fast', minval = 3)
ema_slow_len = input.int(21, 'EMA Slow', minval = 5)
ema_mid_len = input.int(50, 'EMA Mid', minval = 10)
ema_macro_len = input.int(200, 'EMA Macro', minval = 50)
// ADX
adx_len = input.int(14, 'ADX length', minval = 2)
adx_threshold = input.float(15, 'ADX threshold', minval = 10, step = 1)

// VWAP/OBV/Volume
use_vwap_filter = input.bool(false, 'Usar VWAP como filtro (TF altos)')
vwap_session = input.session('0000-2359', 'Sesión para reset VWAP')
use_volume_filter = input.bool(true, 'Usar filtro de volumen')
vol_ma_len = input.int(20, 'Volume SMA length')
volume_mult = input.float(1.2, 'Volume multiplier threshold')
use_obv_filter = input.bool(true, 'Usar OBV en scoring')

// ========================= INPUTS: RIESGO (ATR) =========================
base_atr_sl = input.float(1.5, 'ATR SL base')
base_atr_tp = input.float(2.0, 'ATR TP base')
atr_multiplier_trailing = input.float(3.5, 'ATR multiplicador trailing')
use_volatility_filter = input.bool(true, 'Usar filtro de volatilidad')
volatility_atr_mult = input.float(1.1, 'Volatility ATR multiplier')

// SL/TP separados para long/short
atr_mult_sl_long = input.float(1.3, 'ATR SL multiplicador long')
atr_mult_tp_long = input.float(4.0, 'ATR TP multiplicador long')
atr_mult_sl_short = input.float(1.3, 'ATR SL multiplicador short')
atr_mult_tp_short = input.float(3.0, 'ATR TP multiplicador short')

// ========================= INPUTS: SEÑALES Y FILTROS =========================
signal_threshold = input.float(2.0, 'Umbral de señal (score)', minval = 1.0, step = 0.5)
use_time_filter = input.bool(true, 'Usar filtro de horario')
session_hours = input.session('0900-1600', 'Horario de operación (session)')
show_debug_info = input.bool(true, 'Mostrar info debug (shorts)')

// Pesos configurables para scoring (ajustados para mejorar winrate)
rsi_low_weight_long = input.float(2.5, 'RSI <35 weight LONG')
rsi_oversold_up_weight_long = input.float(1.0, 'RSI <45 y subiendo weight LONG')
ema_cross_weight_long = input.float(2.5, 'EMA fast/slow crossover weight LONG')
ema_above_weight_long = input.float(1.0, 'EMA fast > slow y close > fast weight LONG')
macd_hist_pos_weight_long = input.float(1.0, 'MACD hist >0 weight LONG')
macd_hist_up_weight_long = input.float(0.5, 'MACD hist subiendo weight LONG')
ema_mid_above_weight_long = input.float(0.5, 'Close > EMA mid weight LONG')
ema_mid_bounce_weight_long = input.float(0.7, 'Low < EMA mid y close > mid weight LONG')
bb_lower_weight_long = input.float(1.0, 'Close < BB lower weight LONG')
trend_above_weight_long = input.float(0.5, 'Close > trend MA weight LONG')
volume_weight_long = input.float(0.5, 'Volume filter weight LONG')
vwap_above_weight_long = input.float(0.3, 'Close > VWAP weight LONG')
obv_up_weight_long = input.float(0.5, 'OBV subiendo weight LONG')

rsi_high_weight_short = input.float(2.5, 'RSI >65 weight SHORT')
rsi_overbought_down_weight_short = input.float(2.0, 'RSI >60 y bajando weight SHORT')
ema_crossunder_weight_short = input.float(2.5, 'EMA fast/slow crossunder weight SHORT')
ema_below_weight_short = input.float(1.5, 'EMA fast < slow y close < fast weight SHORT')
macd_hist_neg_weight_short = input.float(1.0, 'MACD hist <0 weight SHORT')
macd_hist_down_weight_short = input.float(1.0, 'MACD hist bajando weight SHORT')
bb_upper_weight_short = input.float(1.0, 'High > BB upper y close < upper weight SHORT')
ema_mid_below_weight_short = input.float(0.5, 'Close < EMA mid weight SHORT')
trend_below_weight_short = input.float(0.5, 'Close < trend MA weight SHORT')
volume_weight_short = input.float(0.5, 'Volume filter weight SHORT')
vwap_below_weight_short = input.float(0.3, 'Close < VWAP weight SHORT')
obv_down_weight_short = input.float(0.5, 'OBV bajando weight SHORT')

// ========================= INPUTS: SOPORTE/RESISTENCIA =========================
pivotLen = input.int(15, 'Pivot length (para SR)', minval = 1)
distanciaMin = input.float(50, 'Distancia mínima entre niveles (en ticks)', minval = 0.1)
maxLineasTipo = input.int(4, 'Máximo de líneas visibles por tipo', minval = 1, maxval = 50)
mostrarSoporteFuerte = input.bool(true, 'Mostrar Soporte Fuerte (mínimo del pivot)')
mostrarResistenciaIntra = input.bool(true, 'Mostrar Resistencia Intradía')
mark_strongest_only = input.bool(false, 'Marcar solo niveles con N toques')
touch_lookback = input.int(300, 'Lookback (barras) para contar toques', minval = 50)
touch_min_count = input.int(3, 'Mínimo toques para considerar fuerte', minval = 1)
touch_tol_ticks = input.float(5.0, 'Tolerancia para contar toques (ticks)')

// ========================= TIMEFRAME ADAPTIVE =========================
_tf = timeframe.period
is_1m = _tf == '1' or _tf == '1S'
is_5m = _tf == '5'
is_15m = _tf == '15'
is_30m = _tf == '30'
is_1h = _tf == '60' or str.upper(_tf) == '1H'

rsi_len = is_1m ? rsi_base_len > 5 ? 5 : rsi_base_len : is_5m ? rsi_base_len : is_15m ? math.max(7, rsi_base_len) : is_30m ? math.max(8, rsi_base_len) : rsi_base_len
atr_mult_sl = is_1m ? base_atr_sl * 1.25 : is_5m ? base_atr_sl * 1.2 : is_15m ? base_atr_sl * 1.05 : is_30m ? base_atr_sl * 1.0 : base_atr_sl * 0.95
atr_mult_tp = is_1m ? base_atr_tp * 1.6 : is_5m ? base_atr_tp * 1.5 : is_15m ? base_atr_tp * 1.25 : is_30m ? base_atr_tp * 1.15 : base_atr_tp

// Mode adjustments
long_threshold = 2.0
short_threshold = 2.0
if mode == 'Conservative'
    long_threshold := 4.0
    short_threshold := 4.5
    atr_mult_sl := atr_mult_sl * 1.15
    atr_mult_tp := atr_mult_tp * 0.95
    atr_mult_tp
else if mode == 'Aggressive'
    long_threshold := 2.0
    short_threshold := 2.5
    atr_mult_sl := atr_mult_sl * 0.9
    atr_mult_tp := atr_mult_tp * 1.25
    atr_mult_tp

// ========================= CÁLCULOS INDICADORES =========================
// RSI
rsi = ta.rsi(close, rsi_len)
rsi_ma = use_ema ? ta.ema(rsi, rsi_ma_length) : ta.sma(rsi, rsi_ma_length)

// MA/Bollinger/Trend
middle = use_ema ? ta.ema(close, bb_length) : ta.sma(close, bb_length)
upper = middle + bb_stddev * ta.stdev(close, bb_length)
lower = middle - bb_stddev * ta.stdev(close, bb_length)
trend_ma = use_ema ? ta.ema(close, trend_length) : ta.sma(close, trend_length)

// EMAs (ScalpStation)
ema_fast = ta.ema(close, ema_fast_len)
ema_slow = ta.ema(close, ema_slow_len)
ema_mid = ta.ema(close, ema_mid_len)
ema_macro = ta.ema(close, ema_macro_len)

// MACD
[macd_line, macd_signal, macd_hist] = ta.macd(close, macd_fast, macd_slow, macd_signal_len)

// ADX (usando ta.dmi)
[diplus, diminus, adx_value] = ta.dmi(adx_len, adx_len)
adx_filter = adx_value > adx_threshold

// ATR/Volatility
atr = ta.atr(14)
volatility_filter = atr > ta.sma(atr, 14) * volatility_atr_mult

// Volume
vol_sma = ta.sma(volume, vol_ma_len)
volume_filter = volume > vol_sma * volume_mult

// VWAP con reset por sesión
var float _vwap_pv = na
var float _vwap_vol = na
if not na(time(timeframe.period, vwap_session)) and time(timeframe.period, vwap_session)[1] == 0
    _vwap_pv := hlc3 * volume
    _vwap_vol := volume
    _vwap_vol
else
    _vwap_pv := nz(_vwap_pv) + hlc3 * volume
    _vwap_vol := nz(_vwap_vol) + volume
    _vwap_vol
vwap = _vwap_vol != 0 ? _vwap_pv / _vwap_vol : na

// OBV
var float obv_var = 0.0
obv_var := nz(obv_var[1]) + (close > close[1] ? volume : close < close[1] ? -volume : 0)
obv = obv_var

// Pivots (para SR)
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// ========================= LÓGICA DE SEÑALES (scoring) =========================
// LONG signals con pesos
long_score = 0.0
if rsi < 35
    long_score := long_score + rsi_low_weight_long
    long_score
if rsi < 45 and rsi > rsi[1]
    long_score := long_score + rsi_oversold_up_weight_long
    long_score
if ta.crossover(ema_fast, ema_slow)
    long_score := long_score + ema_cross_weight_long
    long_score
if ema_fast > ema_slow and close > ema_fast
    long_score := long_score + ema_above_weight_long
    long_score
if macd_hist > 0
    long_score := long_score + macd_hist_pos_weight_long
    long_score
if macd_hist > macd_hist[1]
    long_score := long_score + macd_hist_up_weight_long
    long_score
if close > ema_mid
    long_score := long_score + ema_mid_above_weight_long
    long_score
if low < ema_mid and close > ema_mid
    long_score := long_score + ema_mid_bounce_weight_long
    long_score
if close < lower
    long_score := long_score + bb_lower_weight_long
    long_score
if close > trend_ma
    long_score := long_score + trend_above_weight_long
    long_score
if volume_filter
    long_score := long_score + volume_weight_long
    long_score
if not na(vwap) and use_vwap_filter
    long_score := long_score + (close > vwap ? vwap_above_weight_long : 0)
    long_score
if use_obv_filter and obv > obv[1]
    long_score := long_score + obv_up_weight_long
    long_score

// SHORT signals con pesos
short_score = 0.0
if rsi > 65
    short_score := short_score + rsi_high_weight_short
    short_score
if rsi > 60 and rsi < rsi[1]
    short_score := short_score + rsi_overbought_down_weight_short
    short_score
if ta.crossunder(ema_fast, ema_slow)
    short_score := short_score + ema_crossunder_weight_short
    short_score
if ema_fast < ema_slow and close < ema_fast
    short_score := short_score + ema_below_weight_short
    short_score
if macd_hist < 0
    short_score := short_score + macd_hist_neg_weight_short
    short_score
if macd_hist < macd_hist[1]
    short_score := short_score + macd_hist_down_weight_short
    short_score
if high > upper and close < upper
    short_score := short_score + bb_upper_weight_short
    short_score
if close < ema_mid
    short_score := short_score + ema_mid_below_weight_short
    short_score
if close < trend_ma
    short_score := short_score + trend_below_weight_short
    short_score
if volume_filter
    short_score := short_score + volume_weight_short
    short_score
if not na(vwap) and use_vwap_filter
    short_score := short_score + (close < vwap ? vwap_below_weight_short : 0)
    short_score
if use_obv_filter and obv < obv[1]
    short_score := short_score + obv_down_weight_short
    short_score

// Final signals applying filters
in_session = use_time_filter ? time(timeframe.period, session_hours) > 0 : true
vol_ok = use_volatility_filter ? volatility_filter : true
volu_ok = use_volume_filter ? volume_filter : true

long_ok = long_score >= long_threshold and in_session and vol_ok and volu_ok and adx_filter
short_ok = short_score >= short_threshold and in_session and vol_ok and volu_ok and adx_filter

long_pulse = long_ok and not long_ok[1]
short_pulse = short_ok and not short_ok[1]

// ========================= STRATEGY ENTRIES/EXITS =========================
if long_pulse
    strategy.entry('Long', strategy.long)

if short_pulse
    strategy.entry('Short', strategy.short)

strategy.exit('Exit Long', 'Long', stop = close - atr * atr_mult_sl_long * atr_mult_sl, limit = close + atr * atr_mult_tp_long * atr_mult_tp, trail_points = atr * atr_multiplier_trailing, trail_offset = atr * atr_mult_sl_long)
strategy.exit('Exit Short', 'Short', stop = close + atr * atr_mult_sl_short * atr_mult_sl, limit = close - atr * atr_mult_tp_short * atr_mult_tp, trail_points = atr * atr_multiplier_trailing, trail_offset = atr * atr_mult_sl_short)

// ========================= SL/TP / MARKERS / TRAILING VISUAL =========================
var string last_side = ''
var float last_entry_price = na
var float last_sl = na
var float last_tp = na
var float last_trailing_sl = na
var int last_entry_bar = na
var int last_entry_time = na

var label entry_label = na
var line entry_line = na
var label sl_label = na
var line sl_line = na
var label tp_label = na
var line tp_line = na

f_delete_markers() =>
    if not na(entry_label)
        label.delete(entry_label)
    if not na(entry_line)
        line.delete(entry_line)
    if not na(sl_label)
        label.delete(sl_label)
    if not na(sl_line)
        line.delete(sl_line)
    if not na(tp_label)
        label.delete(tp_label)
    if not na(tp_line)
        line.delete(tp_line)

bar_ms = timeframe.isintraday ? float(timeframe.multiplier) * 60000.0 : 86400000.0
x2_time = int(time + bar_ms * line_extend_bars)

if strategy.position_size > 0
    new_sl = math.max(last_sl, close - atr * atr_mult_sl_long * atr_mult_sl)
    if new_sl > last_trailing_sl
        last_trailing_sl := new_sl
        last_sl := new_sl
        if show_sl_tp_markers and not na(sl_label)
            label.set_y(sl_label, last_sl)
            label.set_text(sl_label, 'SL\n' + str.tostring(last_sl, '#.######'))
        if show_sl_tp_lines and not na(sl_line)
            line.set_y1(sl_line, last_sl)
            line.set_y2(sl_line, last_sl)
else if strategy.position_size < 0
    new_sl = math.min(last_sl, close + atr * atr_mult_sl_short * atr_mult_sl)
    if new_sl < last_trailing_sl
        last_trailing_sl := new_sl
        last_sl := new_sl
        if show_sl_tp_markers and not na(sl_label)
            label.set_y(sl_label, last_sl)
            label.set_text(sl_label, 'SL\n' + str.tostring(last_sl, '#.######'))
        if show_sl_tp_lines and not na(sl_line)
            line.set_y1(sl_line, last_sl)
            line.set_y2(sl_line, last_sl)

if long_pulse
    last_side := 'LONG'
    last_entry_price := close
    last_sl := last_entry_price - atr * atr_mult_sl_long * atr_mult_sl
    last_tp := last_entry_price + atr * atr_mult_tp_long * atr_mult_tp
    last_trailing_sl := last_sl
    last_entry_bar := bar_index
    last_entry_time := int(time)
    f_delete_markers()
    entry_label := label.new(x = last_entry_time, y = last_entry_price, xloc = xloc.bar_time, yloc = yloc.price, text = 'LONG\n' + str.tostring(last_entry_price, '#.######'), style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    if show_sl_tp_lines
        entry_line := line.new(x1 = last_entry_time, y1 = last_entry_price, x2 = x2_time, y2 = last_entry_price, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.green, 0), width = 1)
        entry_line
    if show_sl_tp_markers
        sl_label := label.new(x = last_entry_time, y = last_sl, xloc = xloc.bar_time, yloc = yloc.price, text = 'SL\n' + str.tostring(last_sl, '#.######'), style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
        tp_label := label.new(x = last_entry_time, y = last_tp, xloc = xloc.bar_time, yloc = yloc.price, text = 'TP\n' + str.tostring(last_tp, '#.######'), style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
        if show_sl_tp_lines
            sl_line := line.new(x1 = last_entry_time, y1 = last_sl, x2 = x2_time, y2 = last_sl, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.red, 0), width = 1, style = line.style_dashed)
            tp_line := line.new(x1 = last_entry_time, y1 = last_tp, x2 = x2_time, y2 = last_tp, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.green, 0), width = 1, style = line.style_dashed)
            tp_line

if short_pulse
    last_side := 'SHORT'
    last_entry_price := close
    last_sl := last_entry_price + atr * atr_mult_sl_short * atr_mult_sl
    last_tp := last_entry_price - atr * atr_mult_tp_short * atr_mult_tp
    last_trailing_sl := last_sl
    last_entry_bar := bar_index
    last_entry_time := int(time)
    f_delete_markers()
    entry_label := label.new(x = last_entry_time, y = last_entry_price, xloc = xloc.bar_time, yloc = yloc.price, text = 'SHORT\n' + str.tostring(last_entry_price, '#.######'), style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    if show_sl_tp_lines
        entry_line := line.new(x1 = last_entry_time, y1 = last_entry_price, x2 = x2_time, y2 = last_entry_price, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.red, 0), width = 1)
        entry_line
    if show_sl_tp_markers
        sl_label := label.new(x = last_entry_time, y = last_sl, xloc = xloc.bar_time, yloc = yloc.price, text = 'SL\n' + str.tostring(last_sl, '#.######'), style = label.style_label_up, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
        tp_label := label.new(x = last_entry_time, y = last_tp, xloc = xloc.bar_time, yloc = yloc.price, text = 'TP\n' + str.tostring(last_tp, '#.######'), style = label.style_label_down, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
        if show_sl_tp_lines
            sl_line := line.new(x1 = last_entry_time, y1 = last_sl, x2 = x2_time, y2 = last_sl, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.red, 0), width = 1, style = line.style_dashed)
            tp_line := line.new(x1 = last_entry_time, y1 = last_tp, x2 = x2_time, y2 = last_tp, xloc = xloc.bar_time, extend = extend.none, color = color.new(color.green, 0), width = 1, style = line.style_dashed)
            tp_line

if auto_clear_bars > 0 and not na(last_entry_bar)
    if bar_index - last_entry_bar > auto_clear_bars
        f_delete_markers()
        last_entry_price := na
        last_sl := na
        last_tp := na
        last_trailing_sl := na
        last_entry_bar := na
        last_entry_time := na
        last_side := ''
        last_side

// ========================= PLOTS =========================
plot(show_signals ? ema_fast : na, title = 'EMA Fast', linewidth = 1)
plot(show_signals ? ema_slow : na, title = 'EMA Slow', linewidth = 1)
plot(ema_mid, title = 'EMA Mid', linewidth = 2)
plot(ema_macro, title = 'EMA Macro', linewidth = 1)
plot(middle, title = 'BB Mid', linewidth = 1)
plot(upper, title = 'BB Up', linewidth = 1)
plot(lower, title = 'BB Down', linewidth = 1)
plot(vwap, title = 'VWAP', linewidth = 1)

plotshape(show_signals and long_ok, title = 'Long Signal', style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small)
plotshape(show_signals and short_ok, title = 'Short Signal', style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)

plot(not na(last_sl) ? last_sl : na, title = 'Last SL', style = plot.style_circles)
plot(not na(last_tp) ? last_tp : na, title = 'Last TP', style = plot.style_circles)

// ========================= INFO TABLES =========================
var table info = table.new(position.top_right, 2, 9, border_width = 1, bgcolor = color.new(color.white, 90))
if barstate.islast
    table.cell(info, 0, 0, 'Mode', text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(info, 1, 0, mode, text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(info, 0, 1, 'TF', text_color = color.black)
    table.cell(info, 1, 1, _tf, text_color = color.blue)
    table.cell(info, 0, 2, 'Scores', text_color = color.black)
    table.cell(info, 1, 2, str.tostring(long_score, '#.#') + 'L / ' + str.tostring(short_score, '#.#') + 'S', text_color = color.black)
