// ========================= SOPORTES / RESISTENCIAS DINÁMICAS =========================
var array<float> soporteArr = array.new_float()
var array<float> resistenciaArr = array.new_float()
var array<line> todasLineas = array.new_line()
var array<int> sr_timestamps = array.new_int()

f_nivel_cercano(_lista, _valor, _distMinTicks) =>
    cercano = false
    sz = array.size(_lista)
    tick = syminfo.mintick
    distMin = _distMinTicks * tick
    if sz > 0
        for i = 0 to sz - 1 by 1
            if math.abs(array.get(_lista, i) - _valor) < distMin
                cercano := true
                cercano
    cercano

var array<float> close_history = array.new_float(touch_lookback)
array.shift(close_history)
array.push(close_history, close)

f_count_touches_opt(_level, _tolTicks) =>
    cnt = 0
    tol = _tolTicks * syminfo.mintick
    for i = 0 to array.size(close_history) - 1 by 1
        if math.abs(array.get(close_history, i) - _level) <= tol
            cnt := cnt + 1
            cnt
    cnt

f_draw_level(_arr, _val, _color, _width) =>
    pivTime = time[pivotLen]
    ln = line.new(x1 = pivTime, y1 = _val, x2 = time, y2 = _val, xloc = xloc.bar_time, extend = extend.right, color = _color, width = _width)
    array.push(_arr, _val)
    array.push(todasLineas, ln)
    array.push(sr_timestamps, bar_index)
    label.new(bar_index, _val, text = str.tostring(_val, format.mintick), color = _color, style = label.style_label_left, textcolor = color.black, size = size.tiny)
    while array.size(_arr) > maxLineasTipo
        array.shift(_arr)
        if array.size(todasLineas) > 0
            firstLine = array.shift(todasLineas)
            line.delete(firstLine)
        array.shift(sr_timestamps)

if array.size(sr_timestamps) > 0
    for i = array.size(sr_timestamps) - 1 to 0 by 1
        if bar_index - array.get(sr_timestamps, i) > sr_max_age_bars
            array.remove(sr_timestamps, i)
            if i < array.size(soporteArr)
                array.remove(soporteArr, i)
            else if i < array.size(resistenciaArr)
                array.remove(resistenciaArr, i - array.size(soporteArr))
            if i < array.size(todasLineas)
                line.delete(array.remove(todasLineas, i))

if not na(ph)
    if mostrarResistenciaIntra and not f_nivel_cercano(resistenciaArr, ph, distanciaMin)
        touches = f_count_touches_opt(ph, touch_tol_ticks)
        if not mark_strongest_only or touches >= touch_min_count
            f_draw_level(resistenciaArr, ph, color.rgb(80, 4, 223), 2)

if not na(pl)
    if mostrarSoporteFuerte and not f_nivel_cercano(soporteArr, pl, distanciaMin)
        touches = f_count_touches_opt(pl, touch_tol_ticks)
        if not mark_strongest_only or touches >= touch_min_count
            f_draw_level(soporteArr, pl, color.rgb(249, 250, 252), 2)

